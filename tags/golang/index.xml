&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt; 9&lt;/span&gt;&lt;span&gt; now &lt;span style="color:#ff79c6"&gt;:=&lt;/span&gt; time.&lt;span style="color:#50fa7b"&gt;Now&lt;/span&gt;()
